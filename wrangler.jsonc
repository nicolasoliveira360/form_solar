{
  "name": "form-solar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "META_PIXEL_ID": "1874281433734075"
  },
  // Mantém as variáveis criadas pelo painel (META_TEST_EVENT_CODE, ALLOWED_ORIGIN) a cada deploy.
  // O META_ACCESS_TOKEN é Secret e nunca entra neste arquivo.
  "keep_vars": true
}
